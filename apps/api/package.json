{
  "name": "api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root . --passWithNoTests",
    "lint": "eslint src --fix",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "start:docker": "cd ../.. && docker build -t api -f apps/api/Dockerfile . && docker run --rm --init -p 80:80 api"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
